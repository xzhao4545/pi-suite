diff --git a/dist/api/responses-signatures.d.ts b/dist/api/responses-signatures.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc12e755dc146203a6ea3c7d7626fd6fa80aa10d
--- /dev/null
+++ b/dist/api/responses-signatures.d.ts
@@ -0,0 +1,5 @@
+export type ResponsesPhase = "commentary" | "final_answer";
+export declare function encodeTextSignatureV1(id: string, phase?: ResponsesPhase): string;
+export declare function parseTextSignature(signature?: string): { id: string; phase?: ResponsesPhase } | undefined;
+export declare function parseResponsesToolCallId(id: string): { callId: string; itemId: string | undefined };
+export declare function isResponsesApi(api: string): boolean;
diff --git a/dist/api/responses-signatures.js b/dist/api/responses-signatures.js
new file mode 100644
index 0000000000000000000000000000000000000000..fd7d287085065b61eed24b64621cfcaad371b2e8
--- /dev/null
+++ b/dist/api/responses-signatures.js
@@ -0,0 +1,27 @@
+/** Responses text signatures carry portable phase as well as non-portable server identity. */
+export function encodeTextSignatureV1(id, phase) {
+    const payload = { v: 1, id };
+    if (phase) payload.phase = phase;
+    return JSON.stringify(payload);
+}
+export function parseTextSignature(signature) {
+    if (!signature) return undefined;
+    if (signature.startsWith("{")) {
+        try {
+            const parsed = JSON.parse(signature);
+            if (parsed.v === 1 && typeof parsed.id === "string") {
+                return { id: parsed.id, ...(parsed.phase === "commentary" || parsed.phase === "final_answer" ? { phase: parsed.phase } : {}) };
+            }
+        } catch {
+            // Older histories use an opaque plain-string message id rather than JSON.
+        }
+    }
+    return { id: signature };
+}
+export function parseResponsesToolCallId(id) {
+    const [callId, itemId] = id.split("|");
+    return { callId, itemId };
+}
+export function isResponsesApi(api) {
+    return api === "openai-responses" || api === "openai-codex-responses" || api === "azure-openai-responses";
+}
