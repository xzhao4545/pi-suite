{
  "name": "pi-suite",
  "version": "0.3.0",
  "description": "Custom modular Pi extension suite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzhao4545/pi-suite.git"
  },
  "files": [
    "src",
    "skills",
    "themes",
    "third-party",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test --test-concurrency=4 \"tests/**/*.test.ts\""
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.6.1",
    "@earendil-works/pi-coding-agent": ">=1.6.1",
    "@earendil-works/pi-tui": ">=1.6.1",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@earendil-works/pi-tui": "1.6.1",
    "@narumitw/pi-starship": "0.65.2",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "croner": "10.0.1",
    "zigpty": "0.1.6"
  }
}
