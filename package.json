{
  "name": "pi-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Custom modular Pi extension suite",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/ask/*.test.ts tests/runtime/*.test.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
